VESTIS_NETWORK=vestis-services
WEB_PORT=3000
# Leave empty: the frontend container proxies API calls over the Docker network.
# Vite proxies /auth, /items and /outfits to http://localhost:8080 by default.
# Override the development proxy with VITE_DEV_PROXY_TARGET in your shell.
# For a separate public API: VITE_API_URL=http://localhost:8080
VITE_API_URL=
